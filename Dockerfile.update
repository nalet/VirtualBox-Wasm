FROM virtualbox-wasm:latest

# Copy only the changed files
COPY src/VBox/VMM/VMMAll/IEMAll.cpp /build/vbox/src/VBox/VMM/VMMAll/IEMAll.cpp
COPY src/VBox/VMM/VMMAll/TMAllVirtual.cpp /build/vbox/src/VBox/VMM/VMMAll/TMAllVirtual.cpp
COPY src/VBox/VMM/VMMAll/target-x86/IEMAllCImpl-x86.cpp /build/vbox/src/VBox/VMM/VMMAll/target-x86/IEMAllCImpl-x86.cpp
COPY src/VBox/VMM/VMMR3/VMR3Emt.cpp /build/vbox/src/VBox/VMM/VMMR3/VMR3Emt.cpp
COPY src/VBox/VMM/VMMR3/TMR3.cpp /build/vbox/src/VBox/VMM/VMMR3/TMR3.cpp
COPY src/VBox/VMM/VMMAll/target-x86/IEMAllXcpt-x86.cpp /build/vbox/src/VBox/VMM/VMMAll/target-x86/IEMAllXcpt-x86.cpp
COPY src/VBox/Devices/Storage/DevATA.cpp /build/vbox/src/VBox/Devices/Storage/DevATA.cpp
COPY jit-pre.js /build/vbox/jit-pre.js

WORKDIR /build/vbox

# Touch source files so kmk detects them as newer than cached .o files
RUN touch src/VBox/VMM/VMMAll/IEMAll.cpp \
         src/VBox/VMM/VMMAll/TMAllVirtual.cpp \
         src/VBox/VMM/VMMAll/target-x86/IEMAllCImpl-x86.cpp \
         src/VBox/VMM/VMMAll/target-x86/IEMAllXcpt-x86.cpp \
         src/VBox/VMM/VMMR3/VMR3Emt.cpp \
         src/VBox/VMM/VMMR3/TMR3.cpp \
         src/VBox/Devices/Storage/DevATA.cpp

# Rebuild VBoxVMM (IEMAll.cpp + TMAllVirtual.cpp changed — incremental build)
RUN . /opt/emsdk/emsdk_env.sh 2>/dev/null \
    && export PATH="/build/vbox/kBuild/bin/linux.amd64:${PATH}" \
    && echo "=== Rebuilding VBoxVMM ===" \
    && kmk -C src/VBox/VMM VBoxVMM 2>&1 \
    && echo "=== Rebuilding VBoxDD ===" \
    && kmk -C src/VBox/Devices VBoxDD 2>&1

# Re-link the full wasm binary
RUN . /opt/emsdk/emsdk_env.sh 2>/dev/null \
    && echo "=== Re-linking vbox-wasm.js ===" \
    && mkdir -p docs \
    && em++ -O1 --emit-symbol-map -o docs/vbox-wasm.js wasm-main.cpp wasm-stubs.cpp wasm-display-drv.cpp wasm-kbd-drv.cpp \
        /tmp/extra-o/*.o \
        -I include -I out/linux.amd64/release \
        -I src/VBox/Runtime/include \
        -I src/libs/liblzma-5.8.1/api \
        -DRT_ARCH_AMD64 -D__AMD64__ \
        -DIN_RING3 -DARCH_BITS=64 -DHC_ARCH_BITS=64 \
        -DRT_OS_LINUX -DVBOX -DVBOX_OSE \
        -DVBOX_VMM_TARGET_X86 \
        -DVBOX_WITH_HARDENING \
        out/linux.amd64/release/bin/VBoxVMM.so \
        out/linux.amd64/release/bin/VBoxDD.so \
        out/linux.amd64/release/bin/VBoxDDU.so \
        out/linux.amd64/release/lib/StorageLib.a \
        out/linux.amd64/release/lib/DisasmR3.a \
        out/linux.amd64/release/lib/VBox-SoftFloat.a \
        out/linux.amd64/release/lib/PcBiosBin.a \
        out/linux.amd64/release/lib/VgaBiosBin.a \
        out/linux.amd64/release/lib/VgaDefBiosLogo.a \
        out/linux.amd64/release/lib/RuntimeR3.a \
        out/linux.amd64/release/lib/RuntimeEFCPP.a \
        out/linux.amd64/release/lib/VBox-zlib.a \
        out/linux.amd64/release/lib/VBox-liblzma.a \
        out/linux.amd64/release/lib/VBox-liblzf.a \
        -Wl,--allow-multiple-definition \
        -sMEMORY64=1 \
        -sALLOW_MEMORY_GROWTH=1 \
        -sINITIAL_MEMORY=1073741824 \
        -sSTACK_SIZE=4194304 \
        -sENVIRONMENT=web,worker \
        -sEXPORTED_RUNTIME_METHODS='["callMain","FS"]' \
        --pre-js jit-pre.js \
        -sEXPORTED_FUNCTIONS='["_main","_wasmDisplayGetFB","_wasmDisplayGetWidth","_wasmDisplayGetHeight","_wasmDisplayCheckDirty","_wasmDisplayGetFBSize","_wasmDisplayRefresh","_wasmDisplayGetRefreshCount","_wasmDisplayGetUpdateRectCount","_wasmJitGetGuestRAM","_wasmJitSetGuestRAM","_wasmKbdPutScancode","_wasmKbdDrainQueue","_wasmKbdGetWritePtr","_wasmKbdGetReadPtr","_wasmKbdGetBufPtr","_wasmKbdGetBufSize","_wasmGetDelayRip","_wasmGetDelayRsp","_wasmGetDelayRbp","_wasmGetDelayRet","_wasmGetDelayValid","_wasmReadGuestPhys","_wasmGetGuestReadByte","_wasmXzDecompress","_wasmGetFBCheckCount","_wasmGetFBLastEIP","_wasmGetFBLastHdrS1","_wasmGetFBLastHdrS2","_wasmGetFBBootCS","_wasmGetFBBootActive","_malloc","_free","_wasmPGMPhysWrite","_wasmPGMPhysZero"]' \
        -sINVOKE_RUN=0 \
        -sMODULARIZE=0 \
        -pthread \
        -sPTHREAD_POOL_SIZE=8 \
        -sEXIT_RUNTIME=0 \
        -sALLOW_BLOCKING_ON_MAIN_THREAD=1 \
        -sPROXY_TO_PTHREAD \
        -sFORCE_FILESYSTEM=1 \
        -sDEFAULT_PTHREAD_STACK_SIZE=4194304 \
        -Wno-unused-command-line-argument \
        -sERROR_ON_UNDEFINED_SYMBOLS=0 \
    && ls -lh docs/vbox-wasm.js docs/vbox-wasm.wasm \
    && echo "=== Build OK ==="
